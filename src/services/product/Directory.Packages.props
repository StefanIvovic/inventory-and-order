<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <GlobalPackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="BuildingBlocks.AspNetCore" Version="0.5.0" />
    <PackageVersion Include="BuildingBlocks.EntityFrameworkCore" Version="0.5.0" />
    <PackageVersion Include="BuildingBlocks.Messaging" Version="0.5.0" />
    <PackageVersion Include="BuildingBlocks.Testing" Version="0.5.0" />
    <PackageVersion Include="BuildingBlocks.Validation" Version="0.5.0" />
    <PackageVersion Include="WolverineFx.Http" Version="6.65.1" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.65.1" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
