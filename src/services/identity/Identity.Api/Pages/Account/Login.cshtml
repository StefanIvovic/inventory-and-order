@page "/account/login"
@model Identity.Api.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
@if (Model.ErrorMessage is not null)
{
    <p class="error" role="alert">@Model.ErrorMessage</p>
}
<form method="post">
    <input type="hidden" asp-for="ReturnUrl">
    <label class="field">
        <span>Email</span>
        <input asp-for="Email" type="email" autocomplete="username" required autofocus>
    </label>
    <label class="field">
        <span>Password</span>
        <input asp-for="Password" type="password" autocomplete="current-password" required>
    </label>
    <button type="submit">Sign in</button>
</form>
