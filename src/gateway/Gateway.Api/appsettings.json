{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "Refresh": {
      "Threshold": "00:01:00"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-protocol": {
        "ClusterId": "identity",
        "Match": { "Path": "/connect/{**rest}" }
      },
      "identity-account": {
        "ClusterId": "identity",
        "Match": { "Path": "/account/{**rest}" }
      },
      "identity-discovery": {
        "ClusterId": "identity",
        "Match": { "Path": "/.well-known/{**rest}" }
      },
      "backoffice-spa": {
        "ClusterId": "backoffice-spa",
        "Match": { "Path": "/backoffice/{**rest}" }
      },
      "storefront-spa": {
        "ClusterId": "storefront-spa",
        "Match": { "Path": "/shop/{**rest}" }
      },
      "api-identity": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/identity/{**rest}" },
        "Metadata": { "Session": "required" },
        "Transforms": [
          { "PathRemovePrefix": "/api/identity" }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "main": { "Address": "http://identity-api:8080" }
        }
      },
      "backoffice-spa": {
        "Destinations": {
          "main": { "Address": "http://backoffice-spa:8080" }
        }
      },
      "storefront-spa": {
        "Destinations": {
          "main": { "Address": "http://storefront-spa:8080" }
        }
      }
    }
  }
}
